[gd_scene format=3]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Content" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "LOTWORKS"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Content"]
layout_mode = 2
text = "Workshop Management  /  Asynchronous Auctions"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Content"]
layout_mode = 2
text = "Project scaffold - gameplay not implemented"
horizontal_alignment = 1
